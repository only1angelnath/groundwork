# Sepolia (source chain)
SEPOLIA_RPC_URL=
BILLPAY_CONTRACT_ADDRESS=

# Creditcoin CC3 Testnet (destination chain)
CREDITCOIN_TESTNET_RPC_URL=
GROUNDWORK_ASC_ADDRESS=
CREDIT_VAULT_ADDRESS=

# Relayer key — funded from the Creditcoin testnet faucet, kept SEPARATE
# from any personal/deployer wallet. This key only ever submits proofs;
# it never touches user funds.
RELAYER_PRIVATE_KEY=

# Attestcoin Protocol Prover REST API
# Confirmed against the real @gluwa/usc-sdk package's compiled source
# (proof-provider/service/index.js) — the ProofBuilder class wraps exactly:
#   GET  {PROVER_API_URL}/api/v1/proof-by-tx/{chainKey}/{txHash}
#   GET  {PROVER_API_URL}/api/v1/attested-height/{chainKey}
#   POST {PROVER_API_URL}/api/v1/proof-batch-by-tx/{chainKey}
PROVER_API_URL=https://prover.cc3-testnet.creditcoin.network

# Supabase (service-role key — bypasses RLS by design, worker-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Polling interval (seconds) for the Sepolia event listener
POLL_INTERVAL_SECONDS=10

# Block to start scanning from on a totally fresh run (no saved state file
# yet). Set this to BillPay's actual Sepolia deploy block (see
# contracts/broadcast/DeployBillPay.s.sol/11155111/run-latest.json ->
# receipts[0].blockNumber, currently 0xafe47e = block 11527294) so a first
# run doesn't miss the Phase 1 manual-proof-of-concept payment, and doesn't
# default to scanning from the current chain tip (which would silently miss
# everything already on-chain).
LISTENER_START_BLOCK=11527294

# Optional override for where state.py persists its last-scanned-block
# cursor. Defaults to worker/last_block.json if unset.
LISTENER_STATE_PATH=